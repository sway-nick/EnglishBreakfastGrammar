# ============================================================
# .env — Gemini Answer Processor configuration
# ============================================================
# Copy this file to .env and fill in your values.
# .env is in .gitignore and will never be committed to Git.

# Required: Gemini API key
GEMINI_API_KEY=your_api_key_here

# Optional: Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: override default file paths
# CMS_INPUT_FILE=C:\Users\user\Desktop\english_cms.xlsx
# CMS_OUTPUT_FILE=C:\Users\user\Desktop\english_cms_answered.xlsx
# LOG_FILE=data/logs/gemini_processor.log
