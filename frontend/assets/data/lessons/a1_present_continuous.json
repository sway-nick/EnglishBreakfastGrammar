  "title": "Present continuous: I'm doing, I'm not doing, Are you doing?",
  "description": "Практический тест и правила по теме: Present continuous: I'm doing, I'm not doing, Are you doing?",
  "theory": {
    "title": "Правила и грамматика: Present continuous: I'm doing, I'm not doing, Are you doing?",
    "level": "A1",
    "overview": "В этом уроке мы разберем ключевые правила и нюансы употребления грамматической конструкции «Present continuous: I'm doing, I'm not doing, Are you doing?».",
    "rules": [
      {
        "heading": "Основные правила использования",
        "content": "Конструкция «Present continuous: I'm doing, I'm not doing, Are you doing?» используется для выражения ключевых временных и смысловых отношений в английском языке. Обратите внимание на согласование подлежащего и сказуемого.",
        "table": {
          "headers": [
            "Форма",
            "Пример (EN)",
            "Перевод (RU)"
          ],
          "rows": [
            [
              "Утверждение (+)",
              "I / You / We / They work hard.",
              "Я / Ты / Мы / Они усердно работаем."
            ],
            [
              "Отрицание (-)",
              "He / She / It does not (doesn't) work.",
              "Он / Она / Оно не работает."
            ],
            [
              "Вопрос (?)",
              "Do you work here? — Yes, I do.",
              "Ты работаешь здесь? — Да."
            ]
          ]
        }
      },
      {
        "heading": "Важные нюансы и подсказки",
        "content": "Обращайте внимание на маркеры времени и контекст предложения при выборе правильной формы глагола.",
        "tips": [
          "Внимательно читайте всё предложение до конца перед ответом.",
          "Внимательно проверяйте краткие формы (сокращения с апострофом, например: isn't, don't, 've)."
        ]
      }
    ]
  },
