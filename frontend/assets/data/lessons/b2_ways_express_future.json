  "title": "Other ways to express future: Be about to, be due to, etc.",
  "description": "Практический тест и правила по теме: Other ways to express future: Be about to, be due to, etc.",
  "theory": {
    "title": "Правила и грамматика: Other ways to express future: Be about to, be due to, etc.",
    "level": "B2",
    "overview": "В этом уроке мы разберем ключевые правила и нюансы употребления грамматической конструкции «Other ways to express future: Be about to, be due to, etc.».",
    "rules": [
      {
        "heading": "Основные правила использования",
        "content": "Конструкция «Other ways to express future: Be about to, be due to, etc.» используется для выражения ключевых временных и смысловых отношений в английском языке. Обратите внимание на согласование подлежащего и сказуемого.",
        "table": {
          "headers": [
            "Форма",
            "Пример (EN)",
            "Перевод (RU)"
          ],
          "rows": [
            [
              "Утверждение (+)",
              "I / You / We / They work hard.",
              "Я / Ты / Мы / Они усердно работаем."
            ],
            [
              "Отрицание (-)",
              "He / She / It does not (doesn't) work.",
              "Он / Она / Оно не работает."
            ],
            [
              "Вопрос (?)",
              "Do you work here? — Yes, I do.",
              "Ты работаешь здесь? — Да."
            ]
          ]
        }
      },
      {
        "heading": "Важные нюансы и подсказки",
        "content": "Обращайте внимание на маркеры времени и контекст предложения при выборе правильной формы глагола.",
        "tips": [
          "Внимательно читайте всё предложение до конца перед ответом.",
          "Внимательно проверяйте краткие формы (сокращения с апострофом, например: isn't, don't, 've)."
        ]
      }
    ]
  },
