{
  "lesson_id": "b2_compound_nouns_possessive_forms",
  "level": "B2",
  "title": "Compound nouns and possessive forms",
  "description": "English может объединять nouns в compound nouns и использовать possessive 's для ownership, relationship и некоторых time expressions.",
  "theory": {
    "rule_id": "RULE-B2-24-RU",
    "lesson_num": 24,
    "title": "Правила: Compound nouns and possessive forms",
    "level": "B2",
    "overview": "English может объединять nouns в compound nouns и использовать possessive 's для ownership, relationship и некоторых time expressions.",
    "main_rule": "Compound noun: software developer, data analysis, customer service. Possessive 's: singular owner, plural possessive with apostrophe, irregular plural with 's.",
    "form": "noun + noun. singular noun + 's + noun. plural ending -s + apostrophe. irregular plural + 's.",
    "when_why": "Определи, описывает ли первый noun type/purpose второго или показывает принадлежность/relationship.",
    "examples": "software developer → разработчик ПО.\ndata analysis → анализ данных.\nthe manager's office → офис менеджера.\nthe employees' room → комната сотрудников.\nthe children's books → детские книги.\ntoday's meeting → сегодняшняя встреча.\ntwo weeks' holiday → двухнедельный отпуск.",
    "special_cases": "Plural noun ending in -s takes only apostrophe: students'. Irregular plural takes 's: children's.",
    "common_mistakes": "❌ the students's projects → ✅ the students' projects.\n❌ the children books → ✅ the children's books.",
    "dont_confuse": "Compound noun = type/purpose. Possessive = relationship/ownership/time expression.",
    "quick_summary": "noun+noun = compound noun.\n's = singular/irregular possessive.\ns' = regular plural possessive."
  },
