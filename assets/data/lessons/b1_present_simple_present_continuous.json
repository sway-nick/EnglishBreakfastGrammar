{
  "lesson_id": "b1_present_simple_present_continuous",
  "level": "B1",
  "title": "Present simple or present continuous",
  "description": "Present Simple и Present Continuous оба описывают настоящее, но Simple показывает обычную/стабильную ситуацию, а Continuous — действие сейчас, временную или меняющуюся ситуацию.",
  "theory": {
    "rule_id": "RULE-B1-1-RU",
    "lesson_num": 1,
    "title": "Правила: Present simple or present continuous",
    "level": "B1",
    "overview": "Present Simple и Present Continuous оба описывают настоящее, но Simple показывает обычную/стабильную ситуацию, а Continuous — действие сейчас, временную или меняющуюся ситуацию.",
    "main_rule": "Present Simple — привычки, распорядок, факты и стабильные состояния. Present Continuous = am/is/are + V-ing для происходящего сейчас, временного или меняющегося процесса.",
    "form": "S + V1/V-s. S + am/is/are + V-ing.",
    "when_why": "Сравни: I work with sales data. / I'm working with sales data this week.",
    "examples": "I usually start work at eight. → Я обычно начинаю работу в восемь.\nOur office opens at nine. → Наш офис открывается в девять.\nI'm working from home this week. → На этой неделе я работаю из дома.",
    "special_cases": "Stative verbs such as know, believe, understand, need and belong часто используются в Simple.",
    "common_mistakes": "❌ I am know the answer. → ✅ I know the answer.\n❌ He work from home this week. → ✅ He is working from home this week.",
    "dont_confuse": "routine/stable или temporary/in progress?",
    "quick_summary": "Simple = routine/fact/stable.\nContinuous = now/temporary/changing.\nStative verbs → обычно Simple."
  },
