  "theory": {
    "rule_id": "RULE-Grammar Shorts-22-RU",
    "lesson_num": 22,
    "title": "Правила: Raise vs Rise – Grammar Shorts",
    "level": "SHORTS",
    "overview": "Raise и rise различаются transitivity: raise обычно требует object, rise — обычно нет.",
    "main_rule": "Raise = someone raises something. Rise = something rises by itself. Forms: raise–raised–raised; rise–rose–risen.",
    "form": "raise + object. rise + subject/no direct object.",
    "when_why": "Спроси: кто-то поднимает/увеличивает что-то? → raise. Что-то само повышается/поднимается? → rise.",
    "examples": "They raised the price. → Они повысили цену.\nShe raised her hand. → Она подняла руку.\nPrices rise. → Цены растут.\nThe sun rises. → Солнце встаёт.\nThe temperature is rising. → Температура повышается.",
    "special_cases": "Rise is intransitive in this basic distinction. Raise takes a direct object.",
    "common_mistakes": "❌ They rose the price. → ✅ They raised the price.\n❌ She raised. → Needs object in this meaning: She raised her hand.",
    "dont_confuse": "raise = transitive.\nrise = intransitive.",
    "quick_summary": "raise–raised–raised.\nrise–rose–risen.\nObject → raise."
  },
