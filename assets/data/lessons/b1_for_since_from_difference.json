{
  "lesson_id": "b1_for_since_from_difference",
  "level": "B1",
  "title": "For, since, from: What's the difference?",
  "description": "For, since и from показывают длительность или начало периода, но отвечают на разные вопросы.",
  "theory": {
    "rule_id": "RULE-B1-36-RU",
    "lesson_num": 36,
    "title": "Правила: For, since, from: What's the difference?",
    "level": "B1",
    "overview": "For, since и from показывают длительность или начало периода, но отвечают на разные вопросы.",
    "main_rule": "For = duration. Since = starting point continuing to now/another reference time. From = starting point, often with an endpoint or range.",
    "form": "for + length. since + starting point. from + starting point (+ to/until).",
    "when_why": "For answers «как долго?». Since — «с какого момента?». From часто образует range.",
    "examples": "I've lived here for five years. → Я живу здесь пять лет.\nI've worked here since 2021. → Я работаю здесь с 2021 года.\nThe office is open from nine to five. → Офис открыт с девяти до пяти.",
    "special_cases": "Не путай duration и starting point.",
    "common_mistakes": "❌ I've lived here since five years. → ✅ I've lived here for five years.\n❌ I've worked here for 2021. → ✅ I've worked here since 2021.",
    "dont_confuse": "for = amount of time. since = starting point. from = starting point/range.",
    "quick_summary": "for = how long.\nsince = from when.\nfrom = starting point, often + to."
  },
