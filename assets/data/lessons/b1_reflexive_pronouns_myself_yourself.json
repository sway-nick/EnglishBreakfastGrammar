{
  "lesson_id": "b1_reflexive_pronouns_myself_yourself",
  "level": "B1",
  "title": "Reflexive pronouns: Myself, yourself, etc.",
  "description": "Reflexive pronouns показывают, что subject и object — один и тот же человек/предмет; иногда они просто усиливают subject.",
  "theory": {
    "rule_id": "RULE-B1-11-RU",
    "lesson_num": 11,
    "title": "Правила: Reflexive pronouns: Myself, yourself, etc.",
    "level": "B1",
    "overview": "Reflexive pronouns показывают, что subject и object — один и тот же человек/предмет; иногда они просто усиливают subject.",
    "main_rule": "Forms: myself, yourself, himself, herself, itself, ourselves, yourselves, themselves. By + reflexive может означать alone.",
    "form": "subject + verb + reflexive. by + reflexive.",
    "when_why": "Same person: She hurt herself. Emphasis: I did it myself. Alone: I did it by myself.",
    "examples": "She hurt herself. → Она поранилась.\nI did it myself. → Я сам это сделал.\nWe solved the problem ourselves. → Мы сами решили проблему.\nHe travelled by himself. → Он путешествовал один.",
    "special_cases": "Не ставь reflexive pronoun вместо обычного object pronoun ради формальности.",
    "common_mistakes": "❌ Please contact myself. → ✅ Please contact me.\n❌ She told himself. → ✅ She told herself.",
    "dont_confuse": "Reflexive = same person as subject или emphasis. Ordinary object pronoun = me/him/her.",
    "quick_summary": "myself/yourself/... = сам себя / сам.\nby myself = один.\nНе заменяем ими обычные object pronouns."
  },
