{
  "lesson_id": "b1_any_no_none",
  "level": "B1",
  "title": "Any, no, none: Quantifiers",
  "description": "Any, no и none могут выражать отсутствие/неопределённое количество, но стоят в разных конструкциях.",
  "theory": {
    "rule_id": "RULE-B1-28-RU",
    "lesson_num": 28,
    "title": "Правила: Any, no, none: Quantifiers",
    "level": "B1",
    "overview": "Any, no и none могут выражать отсутствие/неопределённое количество, но стоят в разных конструкциях.",
    "main_rule": "Any + noun может значить one/some/whichever по контексту. No + noun делает предложение отрицательным. None — pronoun, заменяющий noun phrase.",
    "form": "any + noun. no + noun. none without noun.",
    "when_why": "There aren't any tickets. / There are no tickets. / None came.",
    "examples": "There aren't any tickets. → Билетов нет.\nThere are no tickets. → Билетов нет.\nI invited five people, but none came. → Я пригласил пять человек, но никто не пришёл.",
    "special_cases": "В standard English избегаем double negative: I don't have any, not I don't have none.",
    "common_mistakes": "❌ I don't have none. → ✅ I don't have any. / I have none.\n❌ None tickets are left. → ✅ No tickets are left.",
    "dont_confuse": "no требует noun. none заменяет noun phrase.",
    "quick_summary": "any + noun.\nno + noun.\nnone = pronoun.\nNo double negatives."
  },
