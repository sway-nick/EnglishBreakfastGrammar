  "theory": {
    "rule_id": "RULE-B2-30-RU",
    "lesson_num": 30,
    "title": "Правила: Possessive ’s with time expressions: Two hours’ walk",
    "level": "B2",
    "overview": "Possessive forms with time expressions могут показывать duration или distance.",
    "main_rule": "Singular time noun: a day's work, one week's notice. Plural time noun ending in s: two weeks' holiday, five years' experience. Expressions can answer «how long?» and describe a distance/time needed.",
    "form": "singular time + 's. plural time ending in s + '.",
    "when_why": "Используем, когда time expression функционирует как possessive modifier.",
    "examples": "a day's work. → работа на день.\nthree weeks' holiday. → трёхнедельный отпуск.\nten minutes' drive. → десять минут езды.\nIt's two hours' walk. → Это два часа пешком.\nIt's a two-hour walk. → Это двухчасовая прогулка.",
    "special_cases": "Regular plural ending in s takes apostrophe only: hours', weeks', years'. Do not write hours's.",
    "common_mistakes": "❌ two hours's walk → ✅ two hours' walk.\n❌ five years's experience → ✅ five years' experience.",
    "dont_confuse": "Compare possessive form and compound adjective: two hours' walk vs a two-hour walk.",
    "quick_summary": "singular time → 's.\nregular plural time → s'.\nNo double s'."
  },
